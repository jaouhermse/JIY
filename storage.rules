rules_version = '2';
// Nur nötig, wenn USE_STORAGE = true (Fotos & Videos über Firebase Storage, Tarif "Blaze").
service firebase.storage {
  match /b/{bucket}/o {

    function family() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'jaouher.mselmi@gmail.com',
          'email_deiner_frau@outlook.de'
        ];
    }

    match /media/{uid}/{file} {
      allow read: if family();
      allow write: if family()
        && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
