rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nur diese E-Mails gehören zur Familie (klein schreiben!).
    // Muss mit ALLOWED_EMAILS in web/index.html übereinstimmen.
    function family() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'jaouher.mselmi@gmail.com',
          'email_deiner_frau@outlook.de'
        ];
    }

    match /{document=**} {
      allow read, write: if family();
    }
  }
}
