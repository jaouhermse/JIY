rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nur diese E-Mails gehören zur Familie (klein schreiben!).
    // Vorlage – die echten E-Mails stehen nur in der Firebase-Konsole (nicht öffentlich).
    function family() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'deine.email@gmail.com',
          'email.deiner.frau@outlook.de'
        ];
    }

    // 💶 Mein Geld: NUR dieses eine Konto (deine E-Mail, klein geschrieben)
    function geld() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'deine.email@gmail.com';
    }

    // Kalender-Abo: nur mit geheimer Adresse lesbar (keine Liste), schreiben nur Familie
    match /ics/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if family();
    }

    // Haushaltsbuch – nicht für Mama, Kinder oder Gäste
    match /finance/{doc} {
      allow read, write: if geld();
    }

    // Alles andere: ganze Familie (außer finance!)
    match /{col}/{document=**} {
      allow read, write: if family() && col != 'finance';
    }
  }
}
