rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nur diese E-Mails gehören zur Familie (klein schreiben!).
    // Vorlage – die echten E-Mails stehen nur in der Firebase-Konsole (nicht öffentlich).
    function family() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'deine.email@gmail.com',
          'email.deiner.frau@outlook.de'
        ];
    }

    // Kalender-Abo: nur mit geheimer Adresse lesbar (keine Liste), schreiben nur Familie
    match /ics/{token} {
      allow get: if true;
      allow list: if false;
      allow write: if family();
    }

    // Mama + Papa (Haushaltsbuch)
    function eltern() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'deine.email@gmail.com',
          'email.deiner.frau@outlook.de'
        ];
    }

    // 💶 Privates Haushaltsbuch: jeder NUR sein eigenes (Mama sieht Papas nicht und umgekehrt)
    match /financeUser/{uid}/{document=**} {
      allow read, write: if eltern() && request.auth.uid == uid;
    }

    // 👨‍👩‍👦 Gemeinschaftskonten: Mama und Papa
    match /financeShared/{doc} {
      allow read, write: if eltern();
    }

    // Alles andere: ganze Familie (außer Haushaltsbuch!)
    match /{col}/{document=**} {
      allow read, write: if family() && !(col in ['finance', 'financeUser', 'financeShared']);
    }
  }
}
