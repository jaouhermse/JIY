<?xml version="1.0" encoding="utf-8"?>
<!-- Keine App-Daten in Cloud-Backups oder beim Gerätewechsel kopieren
     (Anmeldung, Haushaltsbuch-Zwischenspeicher, FRITZ!Box-Zugang bleiben nur auf diesem Handy). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
